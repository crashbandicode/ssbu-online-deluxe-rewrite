diff --git a/imgui-smash/host-tests/command_memory_reserve_test.cpp b/imgui-smash/host-tests/command_memory_reserve_test.cpp
new file mode 100644
--- /dev/null
+++ b/imgui-smash/host-tests/command_memory_reserve_test.cpp
@@ -0,0 +1,126 @@
+#include "imgui_backend/command_memory_reserve.hpp"
+
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+
+namespace {
+
+int g_failures = 0;
+
+void expect(bool condition, const char *name) {
+  if (!condition) {
+    std::fprintf(stderr, "FAIL %s\n", name);
+    g_failures += 1;
+  }
+}
+
+void test_alignment_and_minimum() {
+  const MemoryBudget small = align_budget(1, 512, 256);
+  expect(small.ok && small.bytes == 512, "request below minimum becomes the device minimum");
+  const MemoryBudget full = align_budget(256u * 1024u, 512, 256);
+  expect(full.ok && full.bytes == 256u * 1024u, "256KiB reserve stays 256KiB");
+  const MemoryBudget bad = align_budget(64, 8, 3);
+  expect(!bad.ok, "non power-of-two alignment is rejected");
+  const SlotReserveLayout layout =
+      plan_slot_memory(1, 1, 256u * 1024u, 64u * 1024u, 512, 64, 256, 64, 4096);
+  expect(layout.ok, "small initial budget plans");
+  expect(layout.command.base == 512, "command base is the device minimum");
+  expect(layout.command.reserve == 256u * 1024u, "command reserve stays full");
+  expect(layout.control.base == 64, "control base is the device minimum");
+  expect(layout.control.reserve == 64u * 1024u, "control reserve stays full");
+  expect(layout.command_pool >= layout.command.base + layout.command.reserve, "pool covers base plus reserve");
+  expect(layout.command_pool % 4096u == 0, "pool size is page rounded");
+  expect(layout.command.base + layout.command.reserve <= layout.command_pool, "reserve fits in the pool");
+}
+
+void test_second_use_and_reset() {
+  MemoryRegion command{512, 4096, false};
+  MemoryRegion control{64, 1024, false};
+  const ReserveSupply first = select_reserve(command, control, ReserveKind::Command, 32);
+  expect(first.choice == ReserveChoice::Supply && first.offset == 512 && first.bytes == 4096, "first command supply");
+  expect(command.used && !control.used, "only command reserve is marked");
+  const ReserveSupply second = select_reserve(command, control, ReserveKind::Command, 32);
+  expect(second.choice == ReserveChoice::Abort, "second command request is rejected");
+  expect(command.used, "rejected request leaves the reserve used");
+  const ReserveSupply control_supply = select_reserve(command, control, ReserveKind::Control, 1024);
+  expect(control_supply.choice == ReserveChoice::Supply && control_supply.offset == 64 && control_supply.bytes == 1024,
+         "unused control reserve can still be supplied");
+  MemoryRegion oversized{512, 4096, false};
+  MemoryRegion unused_control{64, 1024, false};
+  const ReserveSupply huge = select_reserve(oversized, unused_control, ReserveKind::Command, 8192);
+  expect(huge.choice == ReserveChoice::Abort && !oversized.used, "minSize above the reserve is rejected");
+  const ReserveSupply unknown = select_reserve(command, control, ReserveKind::Unrecognized, 1);
+  expect(unknown.choice == ReserveChoice::Abort && command.used && control.used, "unrecognized event is rejected");
+  command = {};
+  control = {};
+  command.base = 512;
+  command.reserve = 4096;
+  control.base = 64;
+  control.reserve = 1024;
+  expect(!command.used && !control.used, "retirement clears both reserves");
+  const ReserveSupply again = select_reserve(command, control, ReserveKind::Command, 32);
+  expect(again.choice == ReserveChoice::Supply, "reset reserve can be supplied again");
+}
+
+struct MockAdd {
+  bool command = false;
+  ptrdiff_t command_offset = -1;
+  size_t command_bytes = 0;
+  uintptr_t control_address = 0;
+  size_t control_bytes = 0;
+};
+
+void apply_mock(const ReserveSupply &supply, ReserveKind kind, unsigned char *control, MockAdd &add) {
+  if (supply.choice != ReserveChoice::Supply) {
+    return;
+  }
+  if (kind == ReserveKind::Command) {
+    add.command = true;
+    add.command_offset = static_cast<ptrdiff_t>(supply.offset);
+    add.command_bytes = supply.bytes;
+    return;
+  }
+  add.control_address = reinterpret_cast<uintptr_t>(control + supply.offset);
+  add.control_bytes = supply.bytes;
+}
+
+void test_mock_callback_regions() {
+  alignas(64) unsigned char control[64 + 1024];
+  std::memset(control, 0, sizeof(control));
+  MemoryRegion command_region{512, 4096, false};
+  MemoryRegion control_region{64, 1024, false};
+  const size_t min_command = 100;
+  const ReserveSupply command =
+      select_reserve(command_region, control_region, reserve_kind_from_event(0), min_command);
+  MockAdd add;
+  apply_mock(command, ReserveKind::Command, control, add);
+  expect(add.command, "mock records a command add");
+  expect(add.command_offset == 512, "command reserve starts after the base");
+  expect(add.command_bytes >= min_command, "command reserve is at least minSize");
+  expect(static_cast<size_t>(add.command_offset) + add.command_bytes > 512, "command reserve is past the base");
+  const size_t min_control = 40;
+  const ReserveSupply control_supply =
+      select_reserve(command_region, control_region, reserve_kind_from_event(1), min_control);
+  apply_mock(control_supply, ReserveKind::Control, control, add);
+  const uintptr_t base = reinterpret_cast<uintptr_t>(control);
+  expect(add.control_address == base + 64, "control reserve does not overlap the base");
+  expect(add.control_bytes >= min_control, "control reserve is at least minSize");
+  expect(reserve_kind_from_event(2) == ReserveKind::Unrecognized, "event 2 is unrecognized");
+  expect(reserve_kind_from_event(0) == ReserveKind::Command, "event 0 is command memory");
+  expect(reserve_kind_from_event(1) == ReserveKind::Control, "event 1 is control memory");
+}
+
+}  // namespace
+
+int main() {
+  test_alignment_and_minimum();
+  test_second_use_and_reset();
+  test_mock_callback_regions();
+  if (g_failures != 0) {
+    std::fprintf(stderr, "%d failure(s)\n", g_failures);
+    return 1;
+  }
+  std::printf("command memory reserve tests passed\n");
+  return 0;
+}
diff --git a/imgui-smash/host-tests/draw_slot_rules_test.cpp b/imgui-smash/host-tests/draw_slot_rules_test.cpp
new file mode 100644
--- /dev/null
+++ b/imgui-smash/host-tests/draw_slot_rules_test.cpp
@@ -0,0 +1,105 @@
+#include "draw_slot_rules.hpp"
+
+#include <cstdio>
+
+static int g_failures = 0;
+
+static void expect(bool condition, const char *name) {
+  if (!condition) {
+    std::fprintf(stderr, "fail %s\n", name);
+    g_failures += 1;
+  }
+}
+
+static void fill(int waits[DrawSlotRules::kCount], int value) {
+  for (int i = 0; i < DrawSlotRules::kCount; ++i) {
+    waits[i] = value;
+  }
+}
+
+static void testPendingIsNotReusable() {
+  DrawSlotRules rules;
+  int waits[DrawSlotRules::kCount];
+  fill(waits, -1);
+  rules.phase[0] = DrawSlotPhase::Submitted;
+  waits[0] = 2;
+  expect(rules.acquire(waits) == 1, "timeout selects the next free slot");
+  expect(rules.phase[0] == DrawSlotPhase::Submitted, "timeout stays submitted");
+  rules.phase[1] = DrawSlotPhase::Recorded;
+  for (int i = 0; i < DrawSlotRules::kCount; ++i) {
+    rules.phase[i] = DrawSlotPhase::Submitted;
+    waits[i] = 2;
+  }
+  expect(rules.acquire(waits) == -1, "all timeouts skip the draw");
+}
+
+static void testSignaledIsReusable() {
+  DrawSlotRules rules;
+  int waits[DrawSlotRules::kCount];
+  fill(waits, 2);
+  rules.phase[0] = DrawSlotPhase::Submitted;
+  waits[0] = 0;
+  expect(rules.acquire(waits) == 0, "already signaled is reusable");
+  rules.phase[0] = DrawSlotPhase::Submitted;
+  rules.cursor = 0;
+  waits[0] = 1;
+  expect(rules.acquire(waits) == 0, "condition satisfied is reusable");
+}
+
+static void testFailureQuarantine() {
+  DrawSlotRules rules;
+  int waits[DrawSlotRules::kCount];
+  fill(waits, -1);
+  rules.phase[0] = DrawSlotPhase::Submitted;
+  waits[0] = 3;
+  expect(rules.acquire(waits) == 1, "failed slot is skipped");
+  expect(rules.phase[0] == DrawSlotPhase::Failed, "failed slot is quarantined");
+  expect(rules.quarantined == 1, "quarantine counted once");
+  rules.phase[1] = DrawSlotPhase::Free;
+  rules.cursor = 0;
+  expect(rules.acquire(waits) == 1, "quarantine persists");
+  expect(rules.quarantined == 1, "second scan does not recount");
+}
+
+static void testRoundRobin() {
+  DrawSlotRules rules;
+  int waits[DrawSlotRules::kCount];
+  fill(waits, -1);
+  for (int i = 0; i < DrawSlotRules::kCount; ++i) {
+    const int got = rules.acquire(waits);
+    expect(got == i, "round robin order");
+    rules.markRecorded(got);
+  }
+  expect(rules.acquire(waits) == -1, "recorded slots are not acquired twice");
+}
+
+static void testUnsubmittedCancel() {
+  DrawSlotRules rules;
+  int waits[DrawSlotRules::kCount];
+  fill(waits, -1);
+  const int first = rules.acquire(waits);
+  rules.markRecorded(first);
+  expect(rules.cancelUnsubmitted(first), "cancel recorded slot");
+  expect(rules.phase[first] == DrawSlotPhase::Free, "cancel returns the slot");
+  expect(!rules.cancelUnsubmitted(first), "cancel is not a second free");
+  rules.cursor = 0;
+  expect(rules.acquire(waits) == first, "cancelled slot can be acquired");
+  rules.markRecorded(0);
+  rules.markSubmitted(0);
+  expect(rules.phase[0] == DrawSlotPhase::Submitted, "recorded slot can be submitted");
+  expect(!rules.cancelUnsubmitted(0), "submitted slot is not cancelled");
+}
+
+int main() {
+  testPendingIsNotReusable();
+  testSignaledIsReusable();
+  testFailureQuarantine();
+  testRoundRobin();
+  testUnsubmittedCancel();
+  if (g_failures != 0) {
+    std::fprintf(stderr, "%d failures\n", g_failures);
+    return 1;
+  }
+  std::printf("draw_slot_rules_test ok\n");
+  return 0;
+}
diff --git a/imgui-smash/host-tests/frame_guard_concurrent_test.cpp b/imgui-smash/host-tests/frame_guard_concurrent_test.cpp
new file mode 100644
--- /dev/null
+++ b/imgui-smash/host-tests/frame_guard_concurrent_test.cpp
@@ -0,0 +1,101 @@
+// Concurrent ownership checks against the frozen frame_guard.cpp helper.
+// Acceptance is FrameEntryOwner itself. This file does not imitate submitCommands.
+
+#include "imgui_backend/frame_guard.hpp"
+
+#include <atomic>
+#include <barrier>
+#include <cstdio>
+#include <cstdlib>
+#include <thread>
+
+namespace {
+
+int g_failures = 0;
+
+void expect(bool condition, const char* name) {
+    if (!condition) {
+        std::fprintf(stderr, "FAIL %s\n", name);
+        g_failures += 1;
+    }
+}
+
+void test_two_threads() {
+    FrameEntryOwner owner;
+    std::barrier<> holding(2);
+    std::barrier<> missed(2);
+    std::barrier<> released(2);
+    std::barrier<> acquired(2);
+    std::atomic<int> miss_holds{-1};
+    std::atomic<int> later_holds{-1};
+
+    std::thread contender([&] {
+        holding.arrive_and_wait();
+        FrameEntryOwner::Claim miss = owner.begin(true);
+        miss_holds.store(miss.holds() ? 1 : 0, std::memory_order_release);
+        missed.arrive_and_wait();
+        released.arrive_and_wait();
+        FrameEntryOwner::Claim later = owner.begin(true);
+        later_holds.store(later.holds() ? 1 : 0, std::memory_order_release);
+        acquired.arrive_and_wait();
+    });
+
+    {
+        FrameEntryOwner::Claim first = owner.begin(true);
+        expect(first.holds(), "first thread holds");
+        holding.arrive_and_wait();
+        missed.arrive_and_wait();
+        expect(miss_holds.load(std::memory_order_acquire) == 0, "second claim fails while held");
+        expect(owner.accepted() == 1, "one accept while held");
+        expect(owner.busy_skips() == 1, "busy increments while held");
+    }
+    released.arrive_and_wait();
+    acquired.arrive_and_wait();
+    contender.join();
+    expect(later_holds.load(std::memory_order_acquire) == 1, "second claim succeeds after release");
+    expect(owner.accepted() == 2, "accept after release");
+    expect(owner.busy_skips() == 1, "later success is not busy");
+}
+
+void leave_early(FrameEntryOwner& owner, int& stage) {
+    FrameEntryOwner::Claim claim = owner.begin(true);
+    if (!claim.holds()) {
+        stage = -1;
+        return;
+    }
+    stage = 1;
+}
+
+void test_early_return_releases() {
+    FrameEntryOwner owner;
+    int stage = 0;
+    leave_early(owner, stage);
+    expect(stage == 1, "early return left a held claim");
+    FrameEntryOwner::Claim next = owner.begin(true);
+    expect(next.holds(), "early return released the claim");
+    expect(owner.accepted() == 2, "accept after early return");
+    expect(owner.busy_skips() == 0, "early return is not a busy skip");
+}
+
+void test_production_getter_abi() {
+    expect(imgui_smash_frame_guard_stats(nullptr) == 0, "null getter returns 0");
+    ImguiSmashFrameGuardStats stats{};
+    expect(imgui_smash_frame_guard_stats(&stats) == 1, "getter returns 1");
+    expect(stats.version == 1, "getter version is 1");
+    expect(stats.size == 24, "getter size is 24");
+    expect(sizeof(ImguiSmashFrameGuardStats) == 24, "local layout is 24");
+}
+
+}  // namespace
+
+int main() {
+    test_two_threads();
+    test_early_return_releases();
+    test_production_getter_abi();
+    if (g_failures != 0) {
+        std::fprintf(stderr, "%d failure(s)\n", g_failures);
+        return 1;
+    }
+    std::printf("frame-guard concurrent tests passed\n");
+    return 0;
+}
diff --git a/imgui-smash/host-tests/frame_guard_test.cpp b/imgui-smash/host-tests/frame_guard_test.cpp
new file mode 100644
--- /dev/null
+++ b/imgui-smash/host-tests/frame_guard_test.cpp
@@ -0,0 +1,123 @@
+#include "imgui_backend/frame_guard.hpp"
+
+#include <cstdio>
+#include <cstdlib>
+
+namespace {
+
+int g_failures = 0;
+
+void expect(bool condition, const char* name) {
+    if (!condition) {
+        std::fprintf(stderr, "FAIL %s\n", name);
+        g_failures++;
+    }
+}
+
+struct SubmitCounts {
+    int original = 0;
+    int overlay = 0;
+};
+
+void submit_once(FrameEntryOwner& owner, bool overlay_ready, SubmitCounts& counts, bool reenter) {
+    FrameEntryOwner::Claim claim = owner.begin(overlay_ready);
+    if (!claim.holds()) {
+        counts.original += 1;
+        return;
+    }
+    counts.overlay += 1;
+    if (reenter) {
+        submit_once(owner, true, counts, false);
+    }
+}
+
+void test_unready_forwards_without_counters() {
+    FrameEntryOwner owner;
+    SubmitCounts counts;
+    submit_once(owner, false, counts, false);
+    expect(counts.original == 1, "unready forwards once");
+    expect(counts.overlay == 0, "unready omits overlay");
+    expect(owner.accepted() == 0, "unready does not accept");
+    expect(owner.busy_skips() == 0, "unready is not busy");
+}
+
+void test_enter_holds_until_release() {
+    FrameEntryOwner owner;
+    SubmitCounts counts;
+    submit_once(owner, true, counts, false);
+    expect(counts.original == 0, "enter does not forward");
+    expect(counts.overlay == 1, "enter draws once");
+    expect(owner.accepted() == 1, "enter accepts one");
+    expect(owner.busy_skips() == 0, "enter is not busy");
+    submit_once(owner, true, counts, false);
+    expect(owner.accepted() == 2, "release allows the next frame");
+    expect(counts.overlay == 2, "second frame enters");
+}
+
+void test_reentry_forwards_once() {
+    FrameEntryOwner owner;
+    SubmitCounts counts;
+    submit_once(owner, true, counts, true);
+    expect(counts.overlay == 1, "outer entry owns the frame");
+    expect(counts.original == 1, "reentry forwards original once");
+    expect(owner.accepted() == 1, "reentry does not accept another frame");
+    expect(owner.busy_skips() == 1, "reentry counts one busy skip");
+    submit_once(owner, true, counts, false);
+    expect(owner.accepted() == 2, "outer release clears the flag");
+    expect(owner.busy_skips() == 1, "later entry is not a busy skip");
+}
+
+void test_exclusive_second_claim() {
+    FrameEntryOwner owner;
+    FrameEntryOwner::Claim first = owner.begin(true);
+    FrameEntryOwner::Claim second = owner.begin(true);
+    expect(first.holds(), "first claim owns");
+    expect(!second.holds(), "second claim does not own");
+    expect(owner.accepted() == 1, "one accepted owner");
+    expect(owner.busy_skips() == 1, "second claim is busy");
+}
+
+void test_getter_copies_atomics() {
+    ImguiSmashFrameGuardStats before{};
+    expect(imgui_smash_frame_guard_stats(nullptr) == 0, "null getter returns 0");
+    expect(imgui_smash_frame_guard_stats(&before) == 1, "getter returns 1");
+    expect(before.version == 1, "version is 1");
+    expect(before.size == 24, "size is 24");
+    const uint64_t accepted = before.accepted;
+    const uint64_t busy = before.busy_skips;
+    {
+        FrameEntryOwner::Claim claim = claim_frame_entry(true);
+        expect(claim.holds(), "production claim owns");
+        FrameEntryOwner::Claim nested = claim_frame_entry(true);
+        expect(!nested.holds(), "production reentry does not own");
+        ImguiSmashFrameGuardStats during{};
+        expect(imgui_smash_frame_guard_stats(&during) == 1, "getter during claim");
+        expect(during.version == 1 && during.size == 24, "abi during claim");
+        expect(during.accepted == accepted + 1, "getter sees accepted");
+        expect(during.busy_skips == busy + 1, "getter sees busy skip");
+    }
+    FrameEntryOwner::Claim after = claim_frame_entry(false);
+    expect(!after.holds(), "unready production claim does not own");
+    ImguiSmashFrameGuardStats stats{};
+    expect(imgui_smash_frame_guard_stats(&stats) == 1, "getter after release");
+    expect(stats.accepted == accepted + 1, "unready does not accept");
+    expect(stats.busy_skips == busy + 1, "unready does not count busy");
+    FrameEntryOwner::Claim again = claim_frame_entry(true);
+    expect(again.holds(), "production release allows another claim");
+}
+
+}  // namespace
+
+int main() {
+    test_unready_forwards_without_counters();
+    test_enter_holds_until_release();
+    test_reentry_forwards_once();
+    test_exclusive_second_claim();
+    test_getter_copies_atomics();
+    if (g_failures != 0) {
+        std::fprintf(stderr, "%d failure(s)\n", g_failures);
+        return 1;
+    }
+    std::printf("frame-guard host tests passed\n");
+    return 0;
+}
diff --git a/imgui-smash/include/imgui_smash_draw_stats.h b/imgui-smash/include/imgui_smash_draw_stats.h
