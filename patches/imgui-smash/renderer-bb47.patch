diff --git a/imgui-smash/src/imgui_backend/command_memory_reserve.hpp b/imgui-smash/src/imgui_backend/command_memory_reserve.hpp
new file mode 100644
--- /dev/null
+++ b/imgui-smash/src/imgui_backend/command_memory_reserve.hpp
@@ -0,0 +1,120 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+
+// Shared by DrawSlots and the host tests. Event codes 0 and 1 are
+// NVNcommandBufferMemoryEvent OUT_OF_COMMAND_MEMORY and OUT_OF_CONTROL_MEMORY.
+
+struct MemoryBudget {
+  size_t bytes = 0;
+  bool ok = false;
+};
+
+inline int device_alignment(int queried, int fallback) {
+  if (queried > 0 && (queried & (queried - 1)) == 0) {
+    return queried;
+  }
+  if (fallback > 0 && (fallback & (fallback - 1)) == 0) {
+    return fallback;
+  }
+  return 0;
+}
+
+inline MemoryBudget align_budget(size_t requested, int minimum, int alignment) {
+  MemoryBudget out;
+  if (alignment <= 0 || (alignment & (alignment - 1)) != 0) {
+    return out;
+  }
+  size_t need = requested;
+  if (minimum > 0) {
+    const size_t min_bytes = static_cast<size_t>(minimum);
+    if (min_bytes > need) {
+      need = min_bytes;
+    }
+  }
+  const size_t align = static_cast<size_t>(alignment);
+  if (need > std::numeric_limits<size_t>::max() - (align - 1u)) {
+    return out;
+  }
+  out.bytes = (need + align - 1u) & ~(align - 1u);
+  out.ok = true;
+  return out;
+}
+
+struct MemoryRegion {
+  size_t base = 0;
+  size_t reserve = 0;
+  bool used = false;
+};
+
+struct SlotReserveLayout {
+  MemoryRegion command;
+  MemoryRegion control;
+  size_t command_pool = 0;
+  bool ok = false;
+};
+
+inline SlotReserveLayout plan_slot_memory(size_t initial_command, size_t initial_control,
+                                         size_t reserve_command, size_t reserve_control, int min_command,
+                                         int min_control, int command_align, int control_align, int pool_page) {
+  SlotReserveLayout layout;
+  const MemoryBudget command_base = align_budget(initial_command, min_command, command_align);
+  const MemoryBudget command_reserve = align_budget(reserve_command, min_command, command_align);
+  const MemoryBudget control_base = align_budget(initial_control, min_control, control_align);
+  const MemoryBudget control_reserve = align_budget(reserve_control, min_control, control_align);
+  if (!command_base.ok || !command_reserve.ok || !control_base.ok || !control_reserve.ok) {
+    return layout;
+  }
+  if (command_base.bytes > std::numeric_limits<size_t>::max() - command_reserve.bytes ||
+      control_base.bytes > std::numeric_limits<size_t>::max() - control_reserve.bytes) {
+    return layout;
+  }
+  const size_t command_bytes = command_base.bytes + command_reserve.bytes;
+  const MemoryBudget pool = align_budget(command_bytes, 0, pool_page);
+  if (!pool.ok || pool.bytes < command_bytes) {
+    return layout;
+  }
+  layout.command = {command_base.bytes, command_reserve.bytes, false};
+  layout.control = {control_base.bytes, control_reserve.bytes, false};
+  layout.command_pool = pool.bytes;
+  layout.ok = true;
+  return layout;
+}
+
+enum class ReserveKind { Command, Control, Unrecognized };
+
+inline ReserveKind reserve_kind_from_event(int event) {
+  if (event == 0) {
+    return ReserveKind::Command;
+  }
+  if (event == 1) {
+    return ReserveKind::Control;
+  }
+  return ReserveKind::Unrecognized;
+}
+
+enum class ReserveChoice { Supply, Abort };
+
+struct ReserveSupply {
+  ReserveChoice choice = ReserveChoice::Abort;
+  size_t offset = 0;
+  size_t bytes = 0;
+};
+
+inline ReserveSupply select_reserve(MemoryRegion &command, MemoryRegion &control, ReserveKind kind, size_t min_size) {
+  ReserveSupply supply;
+  if (kind == ReserveKind::Unrecognized) {
+    return supply;
+  }
+  MemoryRegion &region = kind == ReserveKind::Command ? command : control;
+  if (region.used || min_size > region.reserve) {
+    return supply;
+  }
+  region.used = true;
+  supply.choice = ReserveChoice::Supply;
+  supply.offset = region.base;
+  supply.bytes = region.reserve;
+  return supply;
+}
diff --git a/imgui-smash/src/imgui_backend/draw_slot_rules.hpp b/imgui-smash/src/imgui_backend/draw_slot_rules.hpp
new file mode 100644
--- /dev/null
+++ b/imgui-smash/src/imgui_backend/draw_slot_rules.hpp
@@ -0,0 +1,69 @@
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+// Host-testable acquisition rules for the eight draw slots.
+// Wait codes match nvn::SyncWaitResult: 0 already signaled, 1 condition
+// satisfied, 2 timeout, 3 failed. Any other code leaves a submitted slot pending.
+
+enum class DrawSlotPhase : std::uint8_t { Free, Recorded, Submitted, Failed };
+
+struct DrawSlotRules {
+  static constexpr int kCount = 8;
+
+  DrawSlotPhase phase[kCount]{};
+  int cursor = 0;
+  std::atomic<std::uint64_t> quarantined{0};
+
+  int acquire(const int waits[kCount]) {
+    for (int step = 0; step < kCount; ++step) {
+      const int index = (cursor + step) % kCount;
+      if (phase[index] == DrawSlotPhase::Failed || phase[index] == DrawSlotPhase::Recorded) {
+        continue;
+      }
+      if (phase[index] == DrawSlotPhase::Submitted) {
+        const int wait = waits[index];
+        if (wait == 0 || wait == 1) {
+          cursor = (index + 1) % kCount;
+          return index;
+        }
+        if (wait == 3) {
+          fail(index);
+        }
+        continue;
+      }
+      cursor = (index + 1) % kCount;
+      return index;
+    }
+    return -1;
+  }
+
+  void markRecorded(int index) {
+    if (index >= 0 && index < kCount && phase[index] != DrawSlotPhase::Failed) {
+      phase[index] = DrawSlotPhase::Recorded;
+    }
+  }
+
+  void markSubmitted(int index) {
+    if (index >= 0 && index < kCount && phase[index] == DrawSlotPhase::Recorded) {
+      phase[index] = DrawSlotPhase::Submitted;
+    }
+  }
+
+  bool cancelUnsubmitted(int index) {
+    if (index < 0 || index >= kCount || phase[index] != DrawSlotPhase::Recorded) {
+      return false;
+    }
+    phase[index] = DrawSlotPhase::Free;
+    return true;
+  }
+
+  void fail(int index) {
+    if (index < 0 || index >= kCount || phase[index] == DrawSlotPhase::Failed) {
+      return;
+    }
+    phase[index] = DrawSlotPhase::Failed;
+    quarantined.fetch_add(1, std::memory_order_relaxed);
+  }
+};
diff --git a/imgui-smash/src/imgui_backend/frame_guard.cpp b/imgui-smash/src/imgui_backend/frame_guard.cpp
new file mode 100644
--- /dev/null
+++ b/imgui-smash/src/imgui_backend/frame_guard.cpp
@@ -0,0 +1,36 @@
+#include "frame_guard.hpp"
+
+namespace {
+FrameEntryOwner g_frame_entry;
+}
+
+FrameEntryOwner::Claim FrameEntryOwner::begin(bool overlay_ready) {
+    if (!overlay_ready) {
+        return Claim(nullptr);
+    }
+    if (flag_.test_and_set(std::memory_order_acquire)) {
+        busy_skips_.fetch_add(1, std::memory_order_relaxed);
+        return Claim(nullptr);
+    }
+    accepted_.fetch_add(1, std::memory_order_relaxed);
+    return Claim(this);
+}
+
+void FrameEntryOwner::release() noexcept {
+    flag_.clear(std::memory_order_release);
+}
+
+FrameEntryOwner::Claim claim_frame_entry(bool overlay_ready) {
+    return g_frame_entry.begin(overlay_ready);
+}
+
+extern "C" int imgui_smash_frame_guard_stats(ImguiSmashFrameGuardStats* out) {
+    if (out == nullptr) {
+        return 0;
+    }
+    out->version = 1;
+    out->size = static_cast<uint32_t>(sizeof(ImguiSmashFrameGuardStats));
+    out->accepted = g_frame_entry.accepted();
+    out->busy_skips = g_frame_entry.busy_skips();
+    return 1;
+}
diff --git a/imgui-smash/src/imgui_backend/frame_guard.hpp b/imgui-smash/src/imgui_backend/frame_guard.hpp
new file mode 100644
--- /dev/null
+++ b/imgui-smash/src/imgui_backend/frame_guard.hpp
@@ -0,0 +1,67 @@
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+// Nonblocking exclusive ownership for one ImGui frame entry.
+// Contention does not wait, and this helper never calls ImGui or NVN.
+
+struct ImguiSmashFrameGuardStats {
+    uint32_t version;
+    uint32_t size;
+    uint64_t accepted;
+    uint64_t busy_skips;
+};
+
+static_assert(sizeof(ImguiSmashFrameGuardStats) == 24, "frame guard stats ABI is 24 bytes");
+
+class FrameEntryOwner {
+public:
+    class Claim {
+    public:
+        Claim(const Claim&) = delete;
+        Claim& operator=(const Claim&) = delete;
+        Claim(Claim&&) = delete;
+        Claim& operator=(Claim&&) = delete;
+
+        ~Claim() {
+            if (owner_ != nullptr) {
+                owner_->release();
+            }
+        }
+
+        bool holds() const { return owner_ != nullptr; }
+
+    private:
+        friend class FrameEntryOwner;
+        explicit Claim(FrameEntryOwner* owner) : owner_(owner) {}
+
+        FrameEntryOwner* owner_ = nullptr;
+    };
+
+    FrameEntryOwner() = default;
+    FrameEntryOwner(const FrameEntryOwner&) = delete;
+    FrameEntryOwner& operator=(const FrameEntryOwner&) = delete;
+
+    // overlay_ready false does not touch the flag. A taken flag increments
+    // busy_skips and does not own. A successful test_and_set increments
+    // accepted and owns until the claim is destroyed.
+    Claim begin(bool overlay_ready);
+
+    uint64_t accepted() const { return accepted_.load(std::memory_order_relaxed); }
+    uint64_t busy_skips() const { return busy_skips_.load(std::memory_order_relaxed); }
+
+private:
+    friend class Claim;
+    void release() noexcept;
+
+    std::atomic_flag flag_{};
+    std::atomic<uint64_t> accepted_{0};
+    std::atomic<uint64_t> busy_skips_{0};
+};
+
+// Production owner. Host tests use their own FrameEntryOwner for the
+// ownership cases and this function for the linked getter.
+FrameEntryOwner::Claim claim_frame_entry(bool overlay_ready);
+
+extern "C" int imgui_smash_frame_guard_stats(ImguiSmashFrameGuardStats* out);
