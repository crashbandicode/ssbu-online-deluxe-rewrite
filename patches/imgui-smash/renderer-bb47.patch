 void MemoryBuffer::Finalize() {
-  IM_FREE(memBuffer);
-  pool.Finalize();
-  buffer.Finalize();
+  if (mBufferLive) {
+    buffer.Finalize();
+    mBufferLive = false;
+  }
+  if (mPoolLive) {
+    pool.Finalize();
+    mPoolLive = false;
+  }
+  if (memBuffer != nullptr) {
+    Mem::Deallocate(memBuffer);
+    memBuffer = nullptr;
+  }
+  mIsReady = false;
 }
 
